  "bugs": { "url": "https://github.com/solmarrow/solmarrow-js/issues", "email": "support@solmarrow.com" },
  "repository": { "type": "git", "url": "git+https://github.com/solmarrow/solmarrow-js.git" },
  "author": { "name": "SolMarrow", "email": "support@solmarrow.com", "url": "https://solmarrow.com" },
  "type": "commonjs",
  "main": "./index.js",
